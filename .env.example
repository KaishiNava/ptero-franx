# Runtime
PORT=3000
# Railway runtime: Node 22.x (also enforced by package.json)
DATA_DIR=/data
SERVERS_DIR=/data/servers
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
MAX_UPLOAD_MB=100
PANEL_URL=https://nel.elaina-cloud.my.id
RUNTIME_PORT_START=10000
RUNTIME_PORT_END=20000

# ============================================================
# SUPABASE — REQUIRED
# Server-only secret. NEVER put SUPABASE_SERVICE_ROLE_KEY in app.js.
# ============================================================
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# First root account. If it does not exist, it will be created in Supabase.
ROOT_USERNAME=admin
ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD

# ============================================================
# OPTIONAL — ONE-TIME LEGACY IMPORT ONLY
# These are read, never written. After migration you can remove them.
# ============================================================
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_USERS_PATH=database/users.json
GITHUB_KEYS_PATH=database/access-keys.json
